{
  "name": "@xuanpu/agent-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Xuanpu agent command-line entrypoint with project-local field context",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./events": "./src/events.ts",
    "./field-provider": "./src/field-provider.ts",
    "./runner": "./src/runner.ts"
  },
  "bin": {
    "xuanpu-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xuanpu/oh-my-pi-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
